# ====================================================================
# Pixel Promotion Claim Assistant - Environment Configuration Template
# ====================================================================

# [REQUIRED] Telegram Bot Token issued by @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# [OPTIONAL] Database Connection URL
# SQLite default: sqlite:///pixel_diagnostics.db
# PostgreSQL example: postgresql://postgres:password@localhost:5432/pixel_claim_db
DATABASE_URL=sqlite:///pixel_diagnostics.db

# [OPTIONAL] Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# [OPTIONAL] Browser Automation Headless Mode (true/false)
HEADLESS=true

# [OPTIONAL] Admin Telegram IDs (comma-separated list of integer IDs)
ADMIN_TELEGRAM_IDS=123456789,987654321

# [OPTIONAL] Redis URL (for distributed session storage or rate limiting)
REDIS_URL=redis://localhost:6379/0

