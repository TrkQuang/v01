modules = ["python-3.11"]
run = "pip install -r requirements.txt && (which Xvfb >/dev/null 2>&1 && xvfb-run -a python main.py || python main.py)"
onBoot = "pip install -r requirements.txt"

[nix]
channel = "stable-25_05"
packages = ["chromium", "chromedriver", "xorgserver"]

[workflows]
runButton = "Start application"

[[workflows.workflow]]
name = "Start application"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pip install -r requirements.txt && (which Xvfb >/dev/null 2>&1 && xvfb-run -a python main.py || python main.py)"

[workflows.workflow.metadata]
outputType = "console"
